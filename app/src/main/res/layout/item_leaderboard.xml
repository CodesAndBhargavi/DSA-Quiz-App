<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutLeaderboardItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card_main"
    android:padding="14dp"
    android:layout_marginBottom="8dp"
    android:elevation="1dp">

    <!-- Rank -->
    <TextView
        android:id="@+id/tvLeaderRank"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_icon_circle"
        android:gravity="center"
        android:text="4"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Avatar -->
    <TextView
        android:id="@+id/tvLeaderAvatar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="⚡"
        android:textSize="22sp" />

    <!-- Name & Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/tvLeaderName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Elena Rostova"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLeaderBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DSA Master"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Points -->
    <TextView
        android:id="@+id/tvLeaderPoints"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chip_amber"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="780 pts"
        android:textColor="@color/amber_primary"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
