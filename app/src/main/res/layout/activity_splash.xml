<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:gravity="center_horizontal"
    android:background="@drawable/bg_hero_gradient_purple"
    android:padding="28dp">

    <!-- Top Skip Action -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/btnSkipSplash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="Skip ➔"
            android:textColor="#DDD6FE"
            android:textSize="15sp"
            android:textStyle="bold"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Mascot & Logo -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="👾"
        android:textSize="96sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DSA Quiz"
        android:textColor="@color/white"
        android:textSize="34sp"
        android:textStyle="bold"
        android:letterSpacing="0.02"
        android:layout_marginTop="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Master Data Structures &amp; Algorithms through playful, visual challenges!"
        android:textColor="#E9D5FF"
        android:textSize="15sp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:layout_marginTop="8dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2" />

    <!-- Start Button -->
    <TextView
        android:id="@+id/btnStartQuiz"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="@drawable/bg_option_default"
        android:gravity="center"
        android:text="Let's Start! 🚀"
        android:textColor="@color/primary_purple"
        android:textSize="18sp"
        android:textStyle="bold"
        android:elevation="6dp"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="24dp" />

</LinearLayout>
