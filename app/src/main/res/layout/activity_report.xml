<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <FrameLayout
                android:id="@+id/btnBackReport"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_circle">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="←"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Project Report 📄"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Header Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hero_question"
            android:padding="20dp"
            android:layout_marginBottom="16dp"
            android:elevation="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DSA QUIZ APPLICATION"
                android:textColor="@color/purple_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Minor Project 4 • InternsElite Android + Java"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Developer: Bhargavi Digambar Naik"
                android:textColor="@color/purple_dark"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 1. Objective -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_main"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Project Objective 🎯"
                android:textColor="@color/purple_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="To design and build an interactive Data Structures &amp; Algorithms (DSA) quiz application in Java that provides timed challenges, instant solution feedback, scoring metrics, and local Room database persistence."
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <!-- 2. Features Implemented -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_study"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. Features Implemented ✨"
                android:textColor="@color/mint_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="• 8 Core DSA Topics (Arrays, LinkedList, Trees, Graphs, Sorting, DP, Complexity)\n• Timed Challenge (30s) + Untimed Practice Modes\n• 50:50 Lifeline to eliminate 2 wrong options\n• Instant solution explanation cards\n• No-repeat question session algorithm\n• Results summary with accuracy &amp; Grandmaster badges\n• Detailed Review Answers screen\n• Top 3 Podium Leaderboard\n• Progress statistics &amp; topic mastery meters\n• Room database offline storage"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <!-- 3. Tech Stack & Components -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_practice"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. Tech Stack &amp; Components 🛠️"
                android:textColor="@color/peach_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="• Language: Java (JDK 11 / 17)\n• Database: Room Database (SQLite ORM)\n• Components: Activity, RecyclerView, CardView, Intent, CountDownTimer, AlertDialog, SharedPreferences"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <!-- 4. Key Learnings & Architecture -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_stats"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4. Architecture &amp; Key Learnings 💡"
                android:textColor="@color/sky_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="The app follows a modular architecture separating Activities, Data Models, Database DAOs, and Utilities. Mastered offline Room persistence, smooth animations, and clean Git commit history."
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
