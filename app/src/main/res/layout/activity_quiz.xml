<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:background="@color/bg_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- Top Navigation Bar (Close/Back, Progress, Timer) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <!-- Close / Exit Button -->
            <FrameLayout
                android:id="@+id/btnCloseQuiz"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_icon_circle"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="✕"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Center Progress Section -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp">

                <ProgressBar
                    android:id="@+id/quizProgressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:max="5"
                    android:progress="1"
                    android:progressDrawable="@drawable/bg_progress_custom" />

                <TextView
                    android:id="@+id/tvQuizProgressText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="4dp"
                    android:text="Question 1 of 5"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Timer / Mode Badge -->
            <LinearLayout
                android:id="@+id/layoutTimerBadge"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/bg_pill_time"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:id="@+id/tvQuizTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏱ 00:30"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Main Quiz Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_main"
            android:orientation="vertical"
            android:padding="18dp"
            android:elevation="4dp"
            android:layout_marginBottom="16dp">

            <!-- Card Header (Topic & Streak / Points Badge) -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@+id/tvQuizStreak">

                    <TextView
                        android:id="@+id/tvQuizTopic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✦ Arrays"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvQuizDifficulty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:text="BASIC"
                        android:textColor="@color/primary_teal_dark"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvQuizStreak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/bg_chip_amber"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="🔥 0 Streak"
                    android:textColor="#B45309"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Hero Question Box (Pastel purple/teal gradient) -->
            <LinearLayout
                android:id="@+id/layoutHeroQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero_gradient_purple"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="26dp"
                android:paddingBottom="26dp"
                android:layout_marginBottom="18dp"
                android:elevation="2dp">

                <TextView
                    android:id="@+id/tvQuizQuestionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="What is the average time complexity of accessing an element in an array by its index?"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>

            <!-- Options List (A, B, C, D) -->
            <!-- Option 1 (A) -->
            <LinearLayout
                android:id="@+id/optCard1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_option_default"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/optBadge1"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_badge_default"
                    android:gravity="center"
                    android:text="A"
                    android:textColor="@color/badge_default_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/optText1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="8dp"
                    android:text="O(1)"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/optStatus1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✔"
                    android:textColor="@color/correct_green"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Option 2 (B) -->
            <LinearLayout
                android:id="@+id/optCard2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_option_default"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/optBadge2"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_badge_default"
                    android:gravity="center"
                    android:text="B"
                    android:textColor="@color/badge_default_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/optText2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="8dp"
                    android:text="O(n)"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/optStatus2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✔"
                    android:textColor="@color/correct_green"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Option 3 (C) -->
            <LinearLayout
                android:id="@+id/optCard3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_option_default"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/optBadge3"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_badge_default"
                    android:gravity="center"
                    android:text="C"
                    android:textColor="@color/badge_default_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/optText3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="8dp"
                    android:text="O(log n)"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/optStatus3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✔"
                    android:textColor="@color/correct_green"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Option 4 (D) -->
            <LinearLayout
                android:id="@+id/optCard4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_option_default"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_marginBottom="6dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/optBadge4"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_badge_default"
                    android:gravity="center"
                    android:text="D"
                    android:textColor="@color/badge_default_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/optText4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="8dp"
                    android:text="O(n²)"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/optStatus4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✔"
                    android:textColor="@color/correct_green"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Feedback & Explanation Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardQuizExplanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/correct_green_bg"
            app:strokeColor="@color/correct_green_border"
            app:strokeWidth="1dp"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvQuizExpTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎉 Awesome! Correct Explanation"
                    android:textColor="@color/correct_green_border"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvQuizExpText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Arrays provide constant time O(1) random access."
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Action Controls (Lifeline & Next/Check) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- 50:50 Lifeline Button -->
            <TextView
                android:id="@+id/btnQuizLifeline"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_secondary"
                android:gravity="center"
                android:text="💡 50:50 Hint"
                android:textColor="@color/primary_purple"
                android:textSize="14sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="10dp" />

            <!-- Next / Check Button -->
            <TextView
                android:id="@+id/btnQuizNext"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1.2"
                android:background="@drawable/bg_btn_primary"
                android:gravity="center"
                android:text="Next Question ➔"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
